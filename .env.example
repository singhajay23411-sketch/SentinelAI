# SentinelAI - Environment Variables Template
# Copy this file to .env in each service directory and fill in values.
# NEVER commit actual credentials to git.

# Gemini AI (Required by playstore-service/)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB (Required by playstore-service/ AND backend/)
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://user:password@cluster.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=SentinelAI

# JWT Authentication (Required by playstore-service/enterprise/auth/)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_strong_random_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# FastAPI Service
API_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Node.js Backend
PORT=5000

# Frontend (set in frontend/.env)
VITE_API_URL=http://localhost:8080

# Demo Mode
DEMO_MODE_ENABLED=true
DEMO_ORG_ID=demo-sentinel-financial-services
